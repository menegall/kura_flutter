# Regole di cache per Cloudflare Pages.
# I file che decidono quale versione dell'app caricare non vanno messi in
# cache, altrimenti gli utenti restano sulla versione precedente dopo un deploy.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/flutter_bootstrap.js
  Cache-Control: no-cache

/flutter_service_worker.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/build_info.json
  Cache-Control: no-cache
